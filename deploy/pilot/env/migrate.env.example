# /etc/vanshavali/migrate.env — release step and backups only (chmod 600).
# The schema OWNER (runs migrations, creates the app role, takes pg_dump). Never used by the API.
VSH_DATABASE_URL=postgresql+psycopg://vanshavali_owner:CHANGE_ME@db.internal.example:5432/vanshavali?sslmode=verify-full&sslrootcert=/etc/ssl/certs/ca-certificates.crt
# ensure_app_role (re)creates this role with this password and the grants RLS needs (ADR-0002 §7);
# it must match the user/password in app.env's VSH_DATABASE_URL.
VSH_APP_DB_ROLE=vanshavali_app
VSH_APP_DB_PASSWORD=CHANGE_ME
