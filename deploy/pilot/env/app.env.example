# /etc/vanshavali/app.env — backend and worker settings (chmod 600; owned by the deploy user).
# Values here are PLACEHOLDERS. Generate secrets on the VM (bootstrap-host.sh does) or copy them
# from the secret manager; never commit the real file. Reference: docs/deployment/environment-variables.md
# Fixed by compose.yml (do not set here): VSH_ENV, VSH_JOB_MODE, VSH_STORAGE_BACKEND, VSH_SCANNER,
# VSH_MAIL_BACKEND, VSH_COOKIE_SECURE, VSH_PUBLIC_BASE_URL, VSH_CORS_ORIGINS, FORWARDED_ALLOW_IPS.

# Database: the NON-OWNER application role (row-level security applies). TLS verified.
VSH_DATABASE_URL=postgresql+psycopg://vanshavali_app:CHANGE_ME@db.internal.example:5432/vanshavali?sslmode=verify-full&sslrootcert=/etc/ssl/certs/ca-certificates.crt

# Object storage (private bucket, versioning on). Leave VSH_S3_ENDPOINT_URL empty for AWS S3.
VSH_S3_ENDPOINT_URL=
VSH_S3_REGION=ap-south-1
VSH_S3_BUCKET=vanshavali-pilot-documents
VSH_S3_ACCESS_KEY=CHANGE_ME
VSH_S3_SECRET_KEY=CHANGE_ME

# App-level encryption keys (32 random bytes, base64) and the download-link signing key.
# Losing a data key makes every document it encrypted unreadable: escrow them (secrets-management.md).
VSH_STANDARD_DATA_KEY=CHANGE_ME_base64_32_bytes
VSH_VAULT_DATA_KEY=CHANGE_ME_base64_32_bytes
VSH_SIGNING_KEY=CHANGE_ME_at_least_32_characters

# Email (STARTTLS on 587; SPF/DKIM/DMARC on the sender domain). See docs/operations/email-runbook.md
VSH_SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
VSH_SMTP_PORT=587
VSH_SMTP_USER=CHANGE_ME
VSH_SMTP_PASSWORD=CHANGE_ME
VSH_MAIL_FROM=Vanshavali <no-reply@example.org>

# Prometheus scrape token (the same value goes in /etc/vanshavali/metrics_token for Prometheus)
VSH_METRICS_TOKEN=CHANGE_ME

# Sign in with Google (optional; leave empty to hide the button). Redirect URI registered in Google:
# https://<VSH_DOMAIN>/api/v1/auth/google/callback
VSH_GOOGLE_CLIENT_ID=
VSH_GOOGLE_CLIENT_SECRET=

# Optional tuning (defaults shown)
# VSH_LOG_LEVEL=INFO
# VSH_DB_POOL_SIZE=5
# VSH_DB_MAX_OVERFLOW=10
# VSH_STATEMENT_TIMEOUT_MS=15000
# VSH_LOGIN_RATE_LIMIT_PER_MINUTE=10
