# /etc/vanshavali/backup.env — nightly backups (chmod 600).
# age PUBLIC key: backups are encrypted to it. The matching identity (private key) is NOT kept on the
# VM; it lives offline with the escrowed data keys (docs/security/secrets-management.md).
BACKUP_AGE_RECIPIENT=age1CHANGE_ME
# A separate bucket (ideally a separate account) with Object Lock; these credentials may only
# PutObject/GetObject/ListBucket on it, never delete.
BACKUP_S3_ENDPOINT_URL=
BACKUP_S3_REGION=ap-south-1
BACKUP_S3_BUCKET=vanshavali-pilot-backups
BACKUP_S3_ACCESS_KEY=CHANGE_ME
BACKUP_S3_SECRET_KEY=CHANGE_ME
# Optional dead-man's switch pinged after each successful backup (e.g. a healthchecks.io URL)
BACKUP_HEARTBEAT_URL=
BACKUP_LOCAL_KEEP_DAYS=7
