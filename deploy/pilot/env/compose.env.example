# /etc/vanshavali/compose.env — non-secret settings of the pilot stack (mode 644 is fine).
# Reference: docs/deployment/environment-variables.md
IMAGE_PREFIX=ghcr.io/manishpandey21
VSH_DOMAIN=pilot.example.org
# ACME contact email for automatic certificates ("internal" only for drills without public DNS)
VSH_TLS=ops@example.org
# One uvicorn process per backend replica; OCR/email concurrency = worker replicas
BACKEND_REPLICAS=2
WORKER_REPLICAS=1
