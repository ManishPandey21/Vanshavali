# Copy to .env for docker compose. NEVER commit real secrets; use a secret manager in production.
POSTGRES_PASSWORD=change-me
# Password of vanshavali_app, the non-owner role the API and worker use (row-level security applies)
APP_DB_PASSWORD=change-me-too
MINIO_ROOT_USER=vanshavali
MINIO_ROOT_PASSWORD=change-me-minio
# 32-byte keys, base64-encoded:  python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
VSH_STANDARD_DATA_KEY=
VSH_VAULT_DATA_KEY=
VSH_SIGNING_KEY=
VSH_PUBLIC_BASE_URL=http://localhost:8080
VSH_COOKIE_SECURE=false
# Sign in with Google (ADR-0012). Leave empty to hide the button. Create an OAuth client of type
# "Web application" in Google Cloud and register <VSH_PUBLIC_BASE_URL>/api/v1/auth/google/callback.
VSH_GOOGLE_CLIENT_ID=
VSH_GOOGLE_CLIENT_SECRET=
# Email. console (default) logs messages instead of sending them. For real delivery set smtp and the
# VSH_SMTP_* values: your provider's submission host on 587 with STARTTLS, or a local catcher such as
# Mailpit (VSH_SMTP_HOST=host.docker.internal, VSH_SMTP_PORT=1025, VSH_SMTP_STARTTLS=false).
VSH_MAIL_BACKEND=console
VSH_MAIL_FROM=Vanshavali <no-reply@localhost>
VSH_SMTP_HOST=
VSH_SMTP_PORT=587
VSH_SMTP_USER=
# Single-quote values containing $ (compose expands it otherwise), e.g. VSH_SMTP_PASSWORD='pa$word'
VSH_SMTP_PASSWORD=
VSH_SMTP_STARTTLS=true
